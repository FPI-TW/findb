# Copy to terraform.tfvars outside the repository and review before apply.
aws_region     = "ap-southeast-1"
aws_account_id = "439622209937"
project_tag    = "findb"

# These are existing instances from the Phase 0 inventory. This stack uses
# data sources and aws_ec2_tag only; it never creates or replaces either EC2.
findb_instance_id   = "i-0942016913367a8b2"
fetcher_instance_id = "i-05f518ef183bc31a9"
findb_rds_instance_identifier = "fin-db"

# PR refresh plans intentionally retain this placeholder. Before the first live
# apply, use the on-call recipient's confirmed inbox in an ignored local tfvars;
# do not commit a real contact value to this example or any tracked tfvars file.
# The managed subscription ignores later endpoint drift; follow monitoring.md's
# explicit replacement procedure when the recipient must change.
operational_alert_email = "on-call@example.invalid"

github_repository       = "FPI-TW/findb"
# The current remote state owns aws_iam_openid_connect_provider.github[0].
# Keep the empty ARN and explicit management flag for that state-owned object.
github_oidc_provider_arn    = ""
manage_github_oidc_provider = true

infra_plan_role_name = "staging-infra-plan"
state_bucket_name    = "findb-staging-tofu-state-439622209937"
state_key            = "staging/control-plane.tfstate"
state_kms_key_arn    = "arn:aws:kms:ap-southeast-1:439622209937:key/776159fc-3251-4cd0-98b0-24dfa9e9701d"

findb_deploy_role_name      = "findb-staging-deploy"
fetcher_deploy_role_name    = "fetcher-staging-deploy"
findb_instance_role_name    = "findb-staging-instance"
fetcher_instance_role_name  = "fetcher-staging-instance"
findb_instance_profile_name = "findb-staging-instance"
fetcher_instance_profile_name = "fetcher-staging-instance"

deploy_bundle_bucket_name = "findb-staging-deploy-bundle-439622209937"
deploy_bundle_kms_alias   = "alias/findb-staging-deploy-bundle"
ssm_log_retention_days    = 30
ssm_log_group_prefix      = "/findb/staging"

findb_dns_check_name        = "findb-staging.tingfong.com"
fetcher_dns_check_name      = "findb-staging.tingfong.com"
minimum_free_disk_percent   = 15
minimum_free_inode_percent  = 10
