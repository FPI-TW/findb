{
  "schema_version": 1,
  "unit": "findb",
  "secret_prefix": "findb/staging/findb/",
  "consumers": {
    "migration": {
      "secrets": [
        {"name": "database/migration", "required_keys": ["MIGRATION_DATABASE_URL"]}
      ]
    },
    "nginx": {
      "secrets": [
        {"name": "api/lookup-serve", "required_keys": ["FINDB_LOOKUP_SERVE_API_KEY"]}
      ]
    },
    "compose": {
      "secrets": [
        {"name": "database/application", "required_keys": ["DATABASE_URL"]},
        {"name": "api/admin-break-glass", "required_keys": ["ADMIN_BREAK_GLASS_API_KEY"]},
        {"name": "api/queue-health-admin", "required_keys": ["FINDB_QUEUE_HEALTH_ADMIN_API_KEY"]},
        {"name": "api/static-cache-serve", "required_keys": ["FINDB_STATIC_CACHE_SERVE_API_KEY"]},
        {"name": "rabbitmq/runtime", "required_keys": ["CELERY_BROKER_URL", "RABBITMQ_DEFAULT_USER", "RABBITMQ_DEFAULT_PASS", "RABBITMQ_ERLANG_COOKIE"]},
        {"name": "r2/canonical-publisher", "required_keys": ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_ACCESS_KEY_ID", "CLOUDFLARE_R2_CANONICAL_PUBLISHER_SECRET_ACCESS_KEY"], "optional_keys": ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_SESSION_TOKEN"]},
        {"name": "r2/canonical-reader", "required_keys": ["CLOUDFLARE_R2_CANONICAL_READER_ACCESS_KEY_ID", "CLOUDFLARE_R2_CANONICAL_READER_SECRET_ACCESS_KEY"], "optional_keys": ["CLOUDFLARE_R2_CANONICAL_READER_SESSION_TOKEN"]}
      ],
      "distinct_keys": [
        ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_ACCESS_KEY_ID", "CLOUDFLARE_R2_CANONICAL_READER_ACCESS_KEY_ID"],
        ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_SECRET_ACCESS_KEY", "CLOUDFLARE_R2_CANONICAL_READER_SECRET_ACCESS_KEY"]
      ]
    },
    "canary": {
      "secrets": [
        {"name": "database/application", "required_keys": ["DATABASE_URL"]},
        {"name": "database/migration", "required_keys": ["MIGRATION_DATABASE_URL"]},
        {"name": "api/admin-break-glass", "required_keys": ["ADMIN_BREAK_GLASS_API_KEY"]},
        {"name": "api/queue-health-admin", "required_keys": ["FINDB_QUEUE_HEALTH_ADMIN_API_KEY"]},
        {"name": "api/lookup-serve", "required_keys": ["FINDB_LOOKUP_SERVE_API_KEY"]},
        {"name": "api/static-cache-serve", "required_keys": ["FINDB_STATIC_CACHE_SERVE_API_KEY"]},
        {"name": "rabbitmq/runtime", "required_keys": ["CELERY_BROKER_URL", "RABBITMQ_DEFAULT_USER", "RABBITMQ_DEFAULT_PASS", "RABBITMQ_ERLANG_COOKIE"]},
        {"name": "r2/canonical-publisher", "required_keys": ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_ACCESS_KEY_ID", "CLOUDFLARE_R2_CANONICAL_PUBLISHER_SECRET_ACCESS_KEY"], "optional_keys": ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_SESSION_TOKEN"]},
        {"name": "r2/canonical-reader", "required_keys": ["CLOUDFLARE_R2_CANONICAL_READER_ACCESS_KEY_ID", "CLOUDFLARE_R2_CANONICAL_READER_SECRET_ACCESS_KEY"], "optional_keys": ["CLOUDFLARE_R2_CANONICAL_READER_SESSION_TOKEN"]}
      ],
      "distinct_keys": [
        ["DATABASE_URL", "MIGRATION_DATABASE_URL"],
        ["FINDB_LOOKUP_SERVE_API_KEY", "FINDB_STATIC_CACHE_SERVE_API_KEY", "FINDB_QUEUE_HEALTH_ADMIN_API_KEY", "ADMIN_BREAK_GLASS_API_KEY"],
        ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_ACCESS_KEY_ID", "CLOUDFLARE_R2_CANONICAL_READER_ACCESS_KEY_ID"],
        ["CLOUDFLARE_R2_CANONICAL_PUBLISHER_SECRET_ACCESS_KEY", "CLOUDFLARE_R2_CANONICAL_READER_SECRET_ACCESS_KEY"]
      ]
    }
  }
}
