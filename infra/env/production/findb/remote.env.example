# GitHub Environment: production-findb
# Copy to .env.remote in this directory, chmod 0600, and never commit it.

# Variables
APP_NAME=FinDB
APP_VERSION=0.1.0
DEBUG=false
PORT=8080
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
API_V1_PREFIX=/api/v1
API_KEY_HEADER=X-API-Key
SOURCE_ALLOWLIST_CIDRS=replace-with-production-source-cidrs
SOURCE_TRUST_PROXY_HEADERS=false
SERVE_REQUIRE_AUTH=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RAW_RETENTION_ENABLED=true
RAW_RETENTION_DAYS=30
FINDB_STATIC_CACHE_BASE_URL=https://findb.example.com
FINDB_LATEST_PRICE_WORKERS=12
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_R2_BUCKET=replace-with-production-backend-bucket

# Secrets
FINDB_EC2_HOST=replace-with-production-host
FINDB_EC2_USER=ubuntu
FINDB_EC2_SSH_KEY=replace-with-production-private-key-content
DATABASE_URL=replace-with-production-async-postgresql-url
ADMIN_BREAK_GLASS_API_KEY=replace-with-production-emergency-owner-key
FINDB_LOOKUP_SERVE_API_KEY=replace-with-production-db-backed-lookup-key
FINDB_STATIC_CACHE_SERVE_API_KEY=replace-with-production-db-backed-cache-key
# Optional legacy fallbacks during phased retirement.
SOURCE_API_KEY=
SERVE_API_KEYS=
ADMIN_API_KEY=
CELERY_BROKER_URL=replace-with-production-celery-broker-url
RABBITMQ_DEFAULT_USER=replace-with-production-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-production-rabbitmq-password
RABBITMQ_ERLANG_COOKIE=replace-with-production-long-random-cookie
# Bearer token restricted to Workers R2 Storage: Read.
CLOUDFLARE_R2_CONFIG_READ_API_TOKEN=replace-with-production-r2-config-read-api-token
# Separate S3 credentials restricted to Object Read & Write for this bucket.
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-production-backend-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-production-backend-r2-secret-access-key
# CLOUDFLARE_R2_SESSION_TOKEN=replace-with-production-r2-session-token
