# GitHub Environment: production-fetcher
# This file intentionally has only non-secret control-plane settings. The
# instance role loads all application values from findb/production/fetcher/.
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=replace-with-production-account-id
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::replace-with-production-account-id:role/fetcher-production-deploy
AWS_PROMOTION_ROLE_ARN=arn:aws:iam::replace-with-production-account-id:role/fetcher-production-promotion
AWS_INSTANCE_PROFILE_NAME=fetcher-production-instance
AWS_SSM_LOG_GROUP=/findb/production/fetcher/ssm
AWS_DNS_CHECK_NAME=replace-with-production-dns-name
ECR_REGISTRY=replace-with-production-account-id.dkr.ecr.ap-southeast-1.amazonaws.com
DEPLOY_BUNDLE_BUCKET=replace-with-production-deploy-bundle
DEPLOY_BUNDLE_KMS_KEY_ARN=arn:aws:kms:ap-southeast-1:replace-with-production-account-id:key/replace-with-key-id
STAGING_AWS_ACCOUNT_ID=439622209937
STAGING_PROMOTION_READ_ROLE_ARN=arn:aws:iam::439622209937:role/fetcher-staging-promotion-reader
STAGING_ECR_REGISTRY=439622209937.dkr.ecr.ap-southeast-1.amazonaws.com
STAGING_DEPLOY_BUNDLE_BUCKET=findb-staging-deploy-bundle-439622209937
# PRODUCTION_DEPLOY_ENABLED is intentionally absent until foundation and live acceptance.
