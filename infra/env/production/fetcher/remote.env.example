# GitHub Environment: production-fetcher
# Copy to .env.remote in this directory, chmod 0600, and never commit it.

# Variables
FETCHER_SCHEDULER_DESIRED_STATE=running
FETCHER_SOURCE_API_URL=https://findb.example.com/
FETCHER_REQUEST_TIMEOUT_SECONDS=30
FETCHER_MAX_ATTEMPTS=3
FETCHER_MAX_RETRY_AFTER_SECONDS=30
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_TIMEOUT_SECONDS=30
TWELVE_DATA_MAX_RESPONSE_BYTES=8388608
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_R2_BUCKET=replace-with-production-fetcher-bucket
CLOUDFLARE_R2_PREFIX=raw/twelve-data
CLOUDFLARE_R2_MAX_OBJECT_BYTES=8388608

# Secrets
FETCHER_EC2_HOST=replace-with-production-host
FETCHER_EC2_USER=ec2-user
FETCHER_EC2_SSH_KEY=replace-with-production-private-key-content
# Optional until the FinLab Fetcher consumer is deployed:
# FETCHER_FINLAB_SOURCE_CLIENT_KEY=replace-with-production-finlab-source-client-key
# Optional until the manually dispatched FinLab acquisition smoke is enabled.
# This smoke uses no Source or R2 credential.
# FINLAB_API_TOKEN=replace-with-production-finlab-token
FETCHER_TWELVE_DATA_SOURCE_CLIENT_KEY=replace-with-production-twelve-data-source-client-key
TWELVE_DATA_API_KEY=replace-with-production-twelve-data-api-key
# Bucket-scoped Object Read & Write credentials; never use an account-level
# Workers R2 Storage token in the Fetcher runtime.
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-production-fetcher-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-production-fetcher-r2-secret-access-key
# Optional when using temporary credentials:
# CLOUDFLARE_R2_SESSION_TOKEN=replace-with-production-r2-session-token
