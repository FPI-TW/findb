# GitHub Environment: staging-fetcher
# Copy to .env.remote in this directory, chmod 0600, and never commit it.

# Variables
FETCHER_SCHEDULER_CONTROL_POLL_SECONDS=30
SHIOAJI_SIMULATION=true
FETCHER_SOURCE_API_URL=https://findb.example.com/
FINDB_SERVE_BASE_URL=https://findb.example.com/
FETCHER_CALENDAR_TIMEOUT_SECONDS=10
FETCHER_CALENDAR_CACHE_TTL_SECONDS=300
FETCHER_REQUEST_TIMEOUT_SECONDS=30
FETCHER_MAX_ATTEMPTS=3
FETCHER_MAX_RETRY_AFTER_SECONDS=30
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_TIMEOUT_SECONDS=30
TWELVE_DATA_MAX_RESPONSE_BYTES=8388608
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-32-character-account-id
# The Fetcher has Object Read & Write access only to this raw bucket.
CLOUDFLARE_R2_RAW_BUCKET=replace-with-staging-fetcher-raw-bucket
CLOUDFLARE_R2_MAX_OBJECT_BYTES=8388608
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=439622209937
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::439622209937:role/fetcher-staging-deploy
AWS_INSTANCE_PROFILE_NAME=fetcher-staging-instance
AWS_SSM_LOG_GROUP=/findb/staging/fetcher/ssm
AWS_DNS_CHECK_NAME=findb-staging.tingfong.com

# Secrets
FETCHER_EC2_HOST=replace-with-elastic-ip-or-public-dns
FETCHER_EC2_USER=ec2-user
FETCHER_EC2_SSH_KEY=replace-with-private-key-content
FETCHER_FINLAB_SOURCE_CLIENT_KEY=replace-with-finlab-source-client-key
FETCHER_SHIOAJI_SOURCE_CLIENT_KEY=replace-with-shioaji-source-client-key
FINLAB_API_TOKEN=replace-with-finlab-token
SHIOAJI_API_KEY=replace-with-shioaji-api-key
SHIOAJI_SECRET_KEY=replace-with-shioaji-secret-key
FETCHER_TWELVE_DATA_SOURCE_CLIENT_KEY=replace-with-twelve-data-source-client-key
# Required dedicated read-only Serve credential; never reuse the Source key.
FETCHER_CALENDAR_SERVE_API_KEY=replace-with-calendar-serve-key
TWELVE_DATA_API_KEY=replace-with-twelve-data-api-key
# Bucket-scoped Object Read & Write credentials; never use an account-level
# Workers R2 Storage token in the Fetcher runtime.
CLOUDFLARE_R2_RAW_ACCESS_KEY_ID=replace-with-fetcher-r2-access-key-id
CLOUDFLARE_R2_RAW_SECRET_ACCESS_KEY=replace-with-fetcher-r2-secret-access-key
# Optional when using temporary credentials:
# CLOUDFLARE_R2_RAW_SESSION_TOKEN=replace-with-r2-session-token
