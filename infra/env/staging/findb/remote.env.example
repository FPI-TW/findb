# GitHub Environment: staging-findb
# Copy to .env.remote in this directory, chmod 0600, and never commit it.

# Variables
APP_NAME=FinDB
APP_VERSION=0.1.0
DEBUG=false
PORT=8080
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
API_V1_PREFIX=/api/v1
API_KEY_HEADER=X-API-Key
SOURCE_ALLOWLIST_CIDRS=replace-with-source-cidrs
SOURCE_TRUST_PROXY_HEADERS=false
SERVE_REQUIRE_AUTH=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RAW_RETENTION_ENABLED=true
RAW_RETENTION_DAYS=30
FINDB_STATIC_CACHE_BASE_URL=https://findb.example.com
FINDB_LATEST_PRICE_WORKERS=12
FINDB_PUBLIC_HOST=findb-staging.tingfong.com
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_R2_CANONICAL_BUCKET=replace-with-staging-findb-canonical-bucket
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=439622209937
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::439622209937:role/findb-staging-deploy
AWS_INSTANCE_PROFILE_NAME=findb-staging-instance
AWS_SSM_LOG_GROUP=/findb/staging/findb/ssm
AWS_DNS_CHECK_NAME=findb-staging.tingfong.com

# Secrets
FINDB_EC2_HOST=replace-with-elastic-ip-or-public-dns
FINDB_EC2_USER=ubuntu
FINDB_EC2_SSH_KEY=replace-with-private-key-content
DATABASE_URL=replace-with-async-postgresql-url
ADMIN_BREAK_GLASS_API_KEY=replace-with-emergency-owner-key
FINDB_LOOKUP_SERVE_API_KEY=replace-with-dedicated-db-backed-lookup-key
FINDB_STATIC_CACHE_SERVE_API_KEY=replace-with-dedicated-db-backed-cache-key
# Dedicated DB-backed Admin viewer key for deployment queue-health checks.
FINDB_QUEUE_HEALTH_ADMIN_API_KEY=replace-with-db-backed-admin-viewer-key
CELERY_BROKER_URL=replace-with-celery-broker-url
RABBITMQ_DEFAULT_USER=replace-with-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password
RABBITMQ_ERLANG_COOKIE=replace-with-long-random-cookie
# Worker-only Canonical R2 Object Read & Write credential.
CLOUDFLARE_R2_CANONICAL_PUBLISHER_ACCESS_KEY_ID=replace-with-worker-r2-access-key-id
CLOUDFLARE_R2_CANONICAL_PUBLISHER_SECRET_ACCESS_KEY=replace-with-worker-r2-secret-access-key
# CLOUDFLARE_R2_CANONICAL_PUBLISHER_SESSION_TOKEN=replace-with-worker-r2-session-token
# Serve-only Canonical R2 Object Read credential.
CLOUDFLARE_R2_CANONICAL_READER_ACCESS_KEY_ID=replace-with-serve-r2-access-key-id
CLOUDFLARE_R2_CANONICAL_READER_SECRET_ACCESS_KEY=replace-with-serve-r2-secret-access-key
# CLOUDFLARE_R2_CANONICAL_READER_SESSION_TOKEN=replace-with-serve-r2-session-token
