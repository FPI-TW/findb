SOURCE_API_URL=https://findb.example.com
SOURCE_CLIENT_KEY=replace-with-fetcher-specific-source-client-key
# From the fetcher/ working directory; the container overrides this with /app/contracts.
FETCHER_CONTRACTS_DIR=../contracts
FETCHER_REQUEST_TIMEOUT_SECONDS=30
FETCHER_MAX_ATTEMPTS=3
FETCHER_MAX_RETRY_AFTER_SECONDS=30
# Local scheduler paths; production must mount FETCHER_STATE_PATH on durable storage.
FETCHER_SCHEDULE_FILE=configs/twelve_data_us_common_stocks_daily.v1.json
FETCHER_STATE_PATH=.state/scheduler.sqlite3

# Twelve Data provider credentials belong only to the Fetcher runtime.
TWELVE_DATA_API_KEY=replace-with-twelve-data-api-key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_TIMEOUT_SECONDS=30
TWELVE_DATA_MAX_RESPONSE_BYTES=8388608

# Required for Source delivery and scheduler execution. Scope the R2 API token
# to Object Read & Write for this bucket only.
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_R2_BUCKET=replace-with-fetcher-owned-private-bucket
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Set only when using Cloudflare R2 temporary credentials.
# CLOUDFLARE_R2_SESSION_TOKEN=replace-with-r2-session-token
CLOUDFLARE_R2_PREFIX=raw/twelve-data
CLOUDFLARE_R2_MAX_OBJECT_BYTES=8388608
