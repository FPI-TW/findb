FROM python:3.13-slim

LABEL com.findb.provider-work.protocol="v1"

WORKDIR /app

RUN pip install --no-cache-dir "uv==0.9.9"

COPY fetcher/pyproject.toml fetcher/uv.lock ./
# Runtimes run --read-only, so Python cannot cache bytecode at import time;
# ship it instead. Dependencies compile here, in the layer keyed by uv.lock.
RUN uv sync --frozen --no-dev --no-install-project --extra finlab --compile-bytecode

COPY fetcher/src ./src
COPY fetcher/configs ./configs
COPY contracts ./contracts
# Compile only the project source so a code change stays a small layer.
RUN uv sync --frozen --no-dev --extra finlab \
    && .venv/bin/python -m compileall -q src

# FinLab writes SDK cache data below the account home.  The home is a dedicated
# writable mount at runtime; no shell HOME override is used.
# /app stays root-owned and read-only: runtimes run with --read-only, and a
# recursive chown after uv sync would copy the whole venv into another layer.
RUN groupadd --system --gid 10001 fetcher \
    && useradd --system --uid 10001 --gid fetcher --create-home --home-dir /home/fetcher fetcher \
    && mkdir -p /var/lib/findb-finlab-fetcher \
    && chown -R fetcher:fetcher /home/fetcher /var/lib/findb-finlab-fetcher

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    FETCHER_CONTRACTS_DIR=/app/contracts

VOLUME ["/home/fetcher", "/var/lib/findb-finlab-fetcher"]

USER fetcher

CMD ["findb-fetch-runtime", "--help"]
