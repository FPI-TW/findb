# FinDB Environment Configuration
# Copy this file to .env and modify as needed

# Application
APP_NAME=FinDB
APP_VERSION=0.1.0
DEBUG=false
PORT=8080

# Database
DATABASE_URL=postgresql+asyncpg://findb:findb@localhost:5435/findb
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# API Configuration
API_V1_PREFIX=/api/v1
API_KEY_HEADER=X-API-Key

# Source API Keys (comma-separated)
# These keys are required for data ingestion endpoints
SOURCE_API_KEYS=your-source-api-key-1,your-source-api-key-2
# Required when DEBUG=false (production)
SOURCE_ALLOWLIST_CIDRS=
SOURCE_TRUST_PROXY_HEADERS=false

# Serve API Keys (comma-separated, optional)
# Leave empty if authentication is not required for serve endpoints
SERVE_API_KEYS=
SERVE_REQUIRE_AUTH=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Raw Data Retention
RAW_RETENTION_ENABLED=false
RAW_RETENTION_DAYS=14
