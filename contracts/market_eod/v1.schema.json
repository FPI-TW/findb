{
  "$defs": {
    "DeliveryMode": {
      "description": "Completeness semantics declared by the fetch layer.",
      "enum": [
        "full_snapshot",
        "incremental",
        "backfill"
      ],
      "title": "DeliveryMode",
      "type": "string"
    },
    "IngressBatch": {
      "additionalProperties": false,
      "description": "Batch metadata shared by every versioned ingress payload.",
      "properties": {
        "coverage_end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage End Date"
        },
        "coverage_start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Start Date"
        },
        "data_date": {
          "format": "date",
          "title": "Data Date",
          "type": "string"
        },
        "declared_record_count": {
          "minimum": 0,
          "title": "Declared Record Count",
          "type": "integer"
        },
        "delivery_mode": {
          "$ref": "#/$defs/DeliveryMode"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "sequence_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Count"
        },
        "source_raw_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Raw Ref"
        },
        "source_raw_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Raw Sha256"
        }
      },
      "required": [
        "data_date",
        "delivery_mode",
        "declared_record_count"
      ],
      "title": "IngressBatch",
      "type": "object"
    },
    "IngressDeliveryMetadata": {
      "additionalProperties": false,
      "description": "Optional scheduler context retained for run-level observability.",
      "properties": {
        "scheduled_for": {
          "format": "date-time",
          "title": "Scheduled For",
          "type": "string"
        },
        "slot_id": {
          "enum": [
            "western_markets_window",
            "global_markets_window",
            "taiwan_market_window",
            "asia_pacific_markets_window"
          ],
          "title": "Slot Id",
          "type": "string"
        },
        "target_data_date": {
          "format": "date",
          "title": "Target Data Date",
          "type": "string"
        },
        "work_item_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "scheduled_for",
        "target_data_date",
        "work_item_id"
      ],
      "title": "IngressDeliveryMetadata",
      "type": "object"
    },
    "MarketEODPayload": {
      "additionalProperties": false,
      "description": "Payload body for ``market_eod.v1``.",
      "properties": {
        "batch": {
          "$ref": "#/$defs/IngressBatch"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/MarketEODRow"
          },
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "batch",
        "data"
      ],
      "title": "MarketEODPayload",
      "type": "object"
    },
    "MarketEODRow": {
      "additionalProperties": false,
      "description": "Provider-neutral daily OHLCV row.",
      "properties": {
        "close": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Close"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 10,
              "minLength": 3,
              "pattern": "^[A-Z0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "high": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "open": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open"
        },
        "source_symbol": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Symbol"
        },
        "symbol": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "total_ticks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Ticks"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "turnover": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnover"
        },
        "volume": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "required": [
        "close",
        "symbol",
        "trade_date"
      ],
      "title": "MarketEODRow",
      "type": "object"
    }
  },
  "$id": "urn:findb:ingress-contract:market_eod:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete ``market_eod.v1`` request.",
  "properties": {
    "dataset_key": {
      "maxLength": 50,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Dataset Key",
      "type": "string"
    },
    "delivery": {
      "anyOf": [
        {
          "$ref": "#/$defs/IngressDeliveryMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/MarketEODPayload"
    },
    "request_key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    },
    "schema_id": {
      "const": "market_eod",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "maxLength": 50,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "dataset_key",
    "schema_id",
    "schema_version",
    "source",
    "request_key",
    "idempotency_key",
    "fetched_at",
    "payload"
  ],
