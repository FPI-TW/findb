{
  "$defs": {
    "IndexChangeRow": {
      "additionalProperties": false,
      "description": "One effective addition or deletion, as the publisher's workbook lists it.",
      "properties": {
        "action": {
          "enum": [
            "add",
            "delete"
          ],
          "title": "Action",
          "type": "string"
        },
        "constituents_after": {
          "minimum": 0,
          "title": "Constituents After",
          "type": "integer"
        },
        "count_change": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count Change"
        },
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "listing_place": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Listing Place",
          "type": "string"
        },
        "name_en": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name En"
        },
        "name_zh": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Zh"
        },
        "ordinal": {
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "symbol": {
          "pattern": "^[0-9]{5}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "effective_date",
        "action",
        "symbol",
        "listing_place",
        "constituents_after"
      ],
      "title": "IndexChangeRow",
      "type": "object"
    },
    "IndexChangesBatch": {
      "additionalProperties": false,
      "properties": {
        "coverage_end_date": {
          "default": null,
          "title": "Coverage End Date",
          "type": "null"
        },
        "coverage_start_date": {
          "default": null,
          "title": "Coverage Start Date",
          "type": "null"
        },
        "data_date": {
          "format": "date",
          "title": "Data Date",
          "type": "string"
        },
        "declared_record_count": {
          "minimum": 0,
          "title": "Declared Record Count",
          "type": "integer"
        },
        "delivery_mode": {
          "const": "full_snapshot",
          "title": "Delivery Mode",
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/IndexDocumentEvidence"
        },
        "history_start": {
          "format": "date",
          "title": "History Start",
          "type": "string"
        },
        "index": {
          "$ref": "#/$defs/IndexDescriptor"
        },
        "sequence": {
          "default": null,
          "title": "Sequence",
          "type": "null"
        },
        "sequence_count": {
          "default": null,
          "title": "Sequence Count",
          "type": "null"
        },
        "source_raw_ref": {
          "maxLength": 2048,
          "pattern": "^r2://[0-9a-f]{32}/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9_=-][A-Za-z0-9._=-]*)+$",
          "title": "Source Raw Ref",
          "type": "string"
        },
        "source_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Raw Sha256",
          "type": "string"
        }
      },
      "required": [
        "data_date",
        "delivery_mode",
        "declared_record_count",
        "source_raw_ref",
        "source_raw_sha256",
        "document",
        "index",
        "history_start"
      ],
      "title": "IndexChangesBatch",
      "type": "object"
    },
    "IndexChangesPayload": {
      "additionalProperties": false,
      "description": "Payload body for ``index_constituent_changes.v1``: one index's complete change history.",
      "properties": {
        "batch": {
          "$ref": "#/$defs/IndexChangesBatch"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/IndexChangeRow"
          },
          "minItems": 1,
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "batch",
        "data"
      ],
      "title": "IndexChangesPayload",
      "type": "object"
    },
    "IndexClassification": {
      "additionalProperties": false,
      "description": "The industry an industry index stands for, in the publisher's scheme.",
      "properties": {
        "code": {
          "pattern": "^[0-9]{2}$",
          "title": "Code",
          "type": "string"
        },
        "name_en": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name En",
          "type": "string"
        },
        "name_zh": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Zh"
        },
        "scheme": {
          "const": "hsics",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "code",
        "name_en"
      ],
      "title": "IndexClassification",
      "type": "object"
    },
    "IndexDescriptor": {
      "additionalProperties": false,
      "description": "An index as the document names it; an industry index carries its industry.",
      "properties": {
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndexClassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "code": {
          "pattern": "^[0-9]{5}\\.[0-9]{2}$",
          "title": "Code",
          "type": "string"
        },
        "name_en": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name En",
          "type": "string"
        },
        "name_zh": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Zh"
        },
        "parent_code": {
          "anyOf": [
            {
              "pattern": "^[0-9]{5}\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Code"
        }
      },
      "required": [
        "code",
        "name_en"
      ],
      "title": "IndexDescriptor",
      "type": "object"
    },
    "IndexDocumentEvidence": {
      "additionalProperties": false,
      "description": "The publisher's document the rows were read from, as the publisher served it.\n\n``document_date`` is the date the content speaks for: a report's trading\nday, a workbook's latest effective date, or a release's publication date,\nin the publisher's local time.  ``part_key`` names the part of the document\nthis delivery carries (an index code), or ``document`` for all of it.  The\npublisher's download service sends no ETag and often no Last-Modified.",
      "properties": {
        "document_date": {
          "format": "date",
          "title": "Document Date",
          "type": "string"
        },
        "etag": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "gzip_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Gzip Bytes",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "constituent_report",
            "change_workbook",
            "review_release"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_modified": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified"
        },
        "original_bytes": {
          "maximum": 67108864,
          "minimum": 1,
          "title": "Original Bytes",
          "type": "integer"
        },
        "original_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "part_key": {
          "pattern": "^(?:[0-9]{5}\\.[0-9]{2}|document)$",
          "title": "Part Key",
          "type": "string"
        },
        "publisher": {
          "const": "hsil",
          "title": "Publisher",
          "type": "string"
        },
        "series": {
          "anyOf": [
            {
              "enum": [
                "hsi",
                "hsci"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "url": {
          "maxLength": 500,
          "pattern": "^https://www\\.hsi\\.com\\.hk/[A-Za-z0-9_./?=%&-]+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "publisher",
        "kind",
        "url",
        "document_date",
        "part_key",
        "original_sha256",
        "original_bytes",
        "gzip_bytes"
      ],
      "title": "IndexDocumentEvidence",
      "type": "object"
    },
    "IngressDeliveryMetadata": {
      "additionalProperties": false,
      "description": "Optional scheduler context retained for run-level observability.",
      "properties": {
        "scheduled_for": {
          "format": "date-time",
          "title": "Scheduled For",
          "type": "string"
        },
        "slot_id": {
          "enum": [
            "western_markets_window",
            "global_markets_window",
            "taiwan_market_window",
            "asia_pacific_markets_window"
          ],
          "title": "Slot Id",
          "type": "string"
        },
        "target_data_date": {
          "format": "date",
          "title": "Target Data Date",
          "type": "string"
        },
        "work_item_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "scheduled_for",
        "target_data_date",
        "work_item_id"
      ],
      "title": "IngressDeliveryMetadata",
      "type": "object"
    }
  },
