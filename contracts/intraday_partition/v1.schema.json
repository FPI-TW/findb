{
  "$defs": {
    "IngressDeliveryMetadata": {
      "additionalProperties": false,
      "description": "Optional scheduler context retained for run-level observability.",
      "properties": {
        "scheduled_for": {
          "format": "date-time",
          "title": "Scheduled For",
          "type": "string"
        },
        "slot_id": {
          "enum": [
            "western_markets_window",
            "global_markets_window",
            "taiwan_market_window",
            "asia_pacific_markets_window"
          ],
          "title": "Slot Id",
          "type": "string"
        },
        "target_data_date": {
          "format": "date",
          "title": "Target Data Date",
          "type": "string"
        },
        "work_item_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "scheduled_for",
        "target_data_date",
        "work_item_id"
      ],
      "title": "IngressDeliveryMetadata",
      "type": "object"
    },
    "IntradayPartitionBatch": {
      "additionalProperties": false,
      "description": "A by-reference delivery: provider evidence is mandatory, sequencing is absent.",
      "properties": {
        "coverage_end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage End Date"
        },
        "coverage_start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Start Date"
        },
        "data_date": {
          "format": "date",
          "title": "Data Date",
          "type": "string"
        },
        "declared_record_count": {
          "const": 1,
          "title": "Declared Record Count",
          "type": "integer"
        },
        "delivery_mode": {
          "enum": [
            "incremental",
            "backfill"
          ],
          "title": "Delivery Mode",
          "type": "string"
        },
        "sequence": {
          "default": null,
          "title": "Sequence",
          "type": "null"
        },
        "sequence_count": {
          "default": null,
          "title": "Sequence Count",
          "type": "null"
        },
        "source_raw_ref": {
          "maxLength": 2048,
          "pattern": "^r2://[0-9a-f]{32}/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9_=-][A-Za-z0-9._=-]*)+$",
          "title": "Source Raw Ref",
          "type": "string"
        },
        "source_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Raw Sha256",
          "type": "string"
        }
      },
      "required": [
        "data_date",
        "delivery_mode",
        "declared_record_count",
        "source_raw_ref",
        "source_raw_sha256"
      ],
      "title": "IntradayPartitionBatch",
      "type": "object"
    },
    "IntradayPartitionPayload": {
      "additionalProperties": false,
      "description": "Payload body for ``intraday_partition.v1``: exactly one symbol and trade date.",
      "properties": {
        "batch": {
          "$ref": "#/$defs/IntradayPartitionBatch"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/IntradayPartitionRow"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "batch",
        "data"
      ],
      "title": "IntradayPartitionPayload",
      "type": "object"
    },
    "IntradayPartitionRow": {
      "additionalProperties": false,
      "description": "One symbol's complete trading day, described but not carried.\n\nThe rows are in a stored object the producer already mapped to the layout\nof ``record_kind`` (``INTRADAY_ROW_LAYOUTS``).  Its size, checksum and row\ncount are proven again before the object is used.",
      "properties": {
        "price_adjustment": {
          "const": "none",
          "title": "Price Adjustment",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "bar_1m",
            "tick"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "row_count": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "rows_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Rows Bytes",
          "type": "integer"
        },
        "rows_format": {
          "const": "parquet",
          "title": "Rows Format",
          "type": "string"
        },
        "rows_ref": {
          "maxLength": 2048,
          "pattern": "^r2://[0-9a-f]{32}/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9_=-][A-Za-z0-9._=-]*)+$",
          "title": "Rows Ref",
          "type": "string"
        },
        "rows_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rows Sha256",
          "type": "string"
        },
        "source_symbol": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Symbol"
        },
        "symbol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,49}$",
          "title": "Symbol",
          "type": "string"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "volume_unit": {
          "const": "lot",
          "title": "Volume Unit",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "trade_date",
        "record_kind",
        "row_count",
        "rows_ref",
        "rows_sha256",
        "rows_bytes",
        "rows_format",
        "price_adjustment",
        "volume_unit"
      ],
      "title": "IntradayPartitionRow",
      "type": "object"
    }
  },
  "$id": "urn:findb:ingress-contract:intraday_partition:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
