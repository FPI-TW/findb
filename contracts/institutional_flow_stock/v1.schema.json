          "const": "TWD",
          "title": "Currency",
          "type": "string"
        },
        "row_count": {
          "maximum": 20000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "rows_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Rows Bytes",
          "type": "integer"
        },
        "rows_format": {
          "const": "json",
          "title": "Rows Format",
          "type": "string"
        },
        "rows_ref": {
          "maxLength": 2048,
          "pattern": "^r2://[0-9a-f]{32}/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9_=-][A-Za-z0-9._=-]*)+$",
          "title": "Rows Ref",
          "type": "string"
        },
        "rows_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rows Sha256",
          "type": "string"
        },
        "source_symbol": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Symbol"
        },
        "symbol": {
          "enum": [
            "TWSE",
            "TPEX"
          ],
          "title": "Symbol",
          "type": "string"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "volume_unit": {
          "const": "share",
          "title": "Volume Unit",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "trade_date",
        "currency",
        "row_count",
        "rows_ref",
        "rows_sha256",
        "rows_bytes",
        "rows_format",
        "volume_unit"
      ],
      "title": "InstitutionalFlowStockRow",
      "type": "object"
    }
