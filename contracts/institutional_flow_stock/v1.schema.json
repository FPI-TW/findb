      "title": "InstitutionalFlowStockPayload",
      "type": "object"
    },
    "InstitutionalFlowStockRow": {
      "additionalProperties": false,
      "description": "A board's per-security flows of one day, described but not carried.\n\nThe rows are a stored JSON object in the layout ``INSTITUTIONAL_STOCK_COLUMNS``;\nits size, checksum and row count are proven again before it is read.",
