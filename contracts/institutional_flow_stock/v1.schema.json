      "title": "IngressDeliveryMetadata",
      "type": "object"
    },
    "InstitutionalFlowBatch": {
      "additionalProperties": false,
      "description": "One exchange table of one trading day; the exchange's response is mandatory evidence.",
      "properties": {
        "coverage_end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage End Date"
        },
        "coverage_start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Start Date"
        },
        "data_date": {
          "format": "date",
          "title": "Data Date",
          "type": "string"
        },
        "declared_record_count": {
          "const": 1,
          "title": "Declared Record Count",
          "type": "integer"
        },
        "delivery_mode": {
          "enum": [
            "incremental",
            "backfill"
          ],
          "title": "Delivery Mode",
          "type": "string"
        },
        "sequence": {
          "default": null,
          "title": "Sequence",
          "type": "null"
        },
        "sequence_count": {
          "default": null,
          "title": "Sequence Count",
          "type": "null"
        },
        "source_raw_ref": {
          "maxLength": 2048,
          "pattern": "^r2://[0-9a-f]{32}/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9_=-][A-Za-z0-9._=-]*)+$",
          "title": "Source Raw Ref",
          "type": "string"
        },
        "source_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Raw Sha256",
          "type": "string"
        }
      },
      "required": [
        "data_date",
        "delivery_mode",
        "declared_record_count",
        "source_raw_ref",
        "source_raw_sha256"
      ],
      "title": "InstitutionalFlowBatch",
      "type": "object"
    },
    "InstitutionalFlowStockPayload": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "$ref": "#/$defs/InstitutionalFlowBatch"
