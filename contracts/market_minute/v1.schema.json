          "$ref": "#/$defs/IngressDeliveryMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/MarketMinutePayload"
    },
    "request_key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Request Key",
      "type": "string"
    },
    "schema_id": {
      "const": "market_minute",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "maxLength": 50,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "dataset_key",
    "schema_id",
    "schema_version",
    "source",
    "request_key",
    "idempotency_key",
    "fetched_at",
    "payload"
  ],
  "title": "MarketMinuteIngressRequest",
