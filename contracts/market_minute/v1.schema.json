{
  "$defs": {
    "IngressDeliveryMetadata": {
      "additionalProperties": false,
      "description": "Optional scheduler context retained for run-level observability.",
      "properties": {
        "scheduled_for": {
          "format": "date-time",
          "title": "Scheduled For",
          "type": "string"
        },
        "slot_id": {
          "enum": [
            "western_markets_window",
            "global_markets_window",
            "taiwan_market_window",
            "asia_pacific_markets_window"
          ],
          "title": "Slot Id",
          "type": "string"
        },
        "target_data_date": {
          "format": "date",
          "title": "Target Data Date",
          "type": "string"
        },
        "work_item_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "scheduled_for",
        "target_data_date",
        "work_item_id"
      ],
      "title": "IngressDeliveryMetadata",
      "type": "object"
    },
    "MarketMinuteBatch": {
      "additionalProperties": false,
      "description": "Required sequence identity for Taiwan minute snapshot deliveries.",
      "properties": {
        "anomalies": {
          "items": {
            "$ref": "#/$defs/ProviderFieldAnomaly"
          },
          "maxItems": 15000,
          "title": "Anomalies",
          "type": "array"
        },
        "coverage_end_date": {
          "format": "date",
          "title": "Coverage End Date",
          "type": "string"
        },
        "coverage_start_date": {
          "format": "date",
          "title": "Coverage Start Date",
          "type": "string"
        },
        "daily_update_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Daily Update Id",
          "type": "string"
        },
        "data_date": {
          "format": "date",
          "title": "Data Date",
          "type": "string"
        },
        "declared_record_count": {
          "minimum": 0,
          "title": "Declared Record Count",
          "type": "integer"
        },
        "delivery_mode": {
          "const": "sequenced_snapshot",
          "title": "Delivery Mode",
          "type": "string"
        },
        "provider_usage_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderUsageSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_usage_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderUsageSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequence": {
          "maximum": 99999,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "sequence_count": {
          "maximum": 99999,
          "minimum": 1,
          "title": "Sequence Count",
          "type": "integer"
        },
        "snapshot_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_raw_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Raw Ref"
        },
        "source_raw_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Raw Sha256"
        },
        "symbols_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Symbols Sha256",
          "type": "string"
        },
        "universe_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Universe Id",
          "type": "string"
        }
      },
      "required": [
        "data_date",
        "delivery_mode",
        "declared_record_count",
        "coverage_start_date",
        "coverage_end_date",
        "sequence",
        "sequence_count",
        "snapshot_id",
        "daily_update_id",
        "universe_id",
        "symbols_sha256"
      ],
      "title": "MarketMinuteBatch",
      "type": "object"
    },
    "MarketMinutePayload": {
      "additionalProperties": false,
      "description": "``market_minute.v1`` body normalized into canonical minute bars.",
      "properties": {
        "batch": {
          "$ref": "#/$defs/MarketMinuteBatch"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/MarketMinuteRow"
          },
          "maxItems": 15000,
          "title": "Data",
          "type": "array"
        },
        "symbol_statuses": {
          "items": {
            "$ref": "#/$defs/MinuteSymbolStatus"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Symbol Statuses",
          "type": "array"
        }
      },
      "required": [
        "batch",
        "symbol_statuses",
        "data"
      ],
      "title": "MarketMinutePayload",
      "type": "object"
    },
    "MarketMinuteRow": {
      "additionalProperties": false,
      "description": "A Taiwan one-minute OHLC bar in canonical ingress units.",
      "properties": {
        "bar_end_time": {
          "format": "date-time",
          "title": "Bar End Time",
          "type": "string"
        },
        "bar_start_time": {
          "format": "date-time",
          "title": "Bar Start Time",
          "type": "string"
        },
        "close": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Close"
        },
        "high": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Low"
        },
        "market_timezone": {
          "const": "Asia/Taipei",
          "title": "Market Timezone",
          "type": "string"
        },
        "open": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Open"
        },
        "price_adjustment": {
          "const": "none",
          "title": "Price Adjustment",
          "type": "string"
        },
        "signal_time": {
          "format": "date-time",
          "title": "Signal Time",
          "type": "string"
        },
        "source_symbol": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Symbol"
        },
        "symbol": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "trade_count": {
          "const": null,
          "default": null,
          "title": "Trade Count",
          "type": "null"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "turnover": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnover"
        },
        "volume": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        }
      },
      "required": [
        "open",
        "high",
        "low",
        "close",
        "symbol",
        "trade_date",
        "market_timezone",
        "bar_start_time",
        "bar_end_time",
        "signal_time",
        "price_adjustment"
      ],
      "title": "MarketMinuteRow",
      "type": "object"
    },
    "MinuteSymbolOutcome": {
      "enum": [
        "data",
        "expected_no_data",
        "error"
      ],
      "title": "MinuteSymbolOutcome",
      "type": "string"
    },
    "MinuteSymbolStatus": {
      "additionalProperties": false,
      "description": "Credential-free completeness outcome for a requested symbol.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/MinuteSymbolOutcome"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "symbol": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "outcome"
      ],
      "title": "MinuteSymbolStatus",
      "type": "object"
    },
    "ProviderFieldAnomaly": {
      "additionalProperties": false,
      "description": "Adapter observation for invalid provider volume/turnover values.",
      "properties": {
        "bar_start_time": {
          "format": "date-time",
          "title": "Bar Start Time",
          "type": "string"
        },
        "field": {
          "enum": [
            "volume",
            "turnover"
          ],
          "title": "Field",
          "type": "string"
        },
        "raw_value": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "raw_value_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Value Sha256",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "symbol": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "bar_start_time",
        "field",
        "raw_value",
        "reason",
        "raw_value_sha256"
      ],
      "title": "ProviderFieldAnomaly",
      "type": "object"
    },
    "ProviderUsageSnapshot": {
      "additionalProperties": false,
      "description": "Provider usage counters deliberately exclude account and credential details.",
      "properties": {
        "requests_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requests Limit"
        },
        "requests_used": {
          "minimum": 0,
          "title": "Requests Used",
          "type": "integer"
        }
      },
      "required": [
        "requests_used"
      ],
      "title": "ProviderUsageSnapshot",
      "type": "object"
    }
  },
  "$id": "urn:findb:ingress-contract:market_minute:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete ``market_minute.v1`` request shape with runtime normalization.",
  "properties": {
