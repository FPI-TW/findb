{
  "$defs": {
    "IngressDeliveryMetadata": {
      "additionalProperties": false,
      "description": "Optional scheduler context retained for run-level observability.",
      "properties": {
        "scheduled_for": {
          "format": "date-time",
          "title": "Scheduled For",
          "type": "string"
        },
        "slot_id": {
          "enum": [
            "western_markets_window",
            "global_markets_window",
            "taiwan_market_window",
            "asia_pacific_markets_window"
          ],
          "title": "Slot Id",
          "type": "string"
        },
        "target_data_date": {
          "format": "date",
          "title": "Target Data Date",
          "type": "string"
        },
        "work_item_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "scheduled_for",
        "target_data_date",
        "work_item_id"
      ],
      "title": "IngressDeliveryMetadata",
      "type": "object"
    },
    "InstitutionalFlowAmount": {
      "additionalProperties": false,
      "description": "One investor category's TWD totals as the exchange printed them.",
      "properties": {
        "buy_amount": {
          "maximum": 1000000000000000000,
          "minimum": 0,
          "title": "Buy Amount",
          "type": "integer"
        },
        "category": {
          "enum": [
            "foreign_ex_dealer",
            "foreign_dealer",
            "investment_trust",
            "dealer_proprietary",
            "dealer_hedge",
            "foreign_total",
            "dealer_total",
            "total"
          ],
          "title": "Category",
          "type": "string"
        },
        "net_amount": {
          "maximum": 1000000000000000000,
          "minimum": -1000000000000000000,
          "title": "Net Amount",
          "type": "integer"
        },
        "sell_amount": {
          "maximum": 1000000000000000000,
          "minimum": 0,
          "title": "Sell Amount",
          "type": "integer"
        }
      },
      "required": [
        "category",
        "buy_amount",
        "sell_amount",
        "net_amount"
      ],
      "title": "InstitutionalFlowAmount",
      "type": "object"
    },
    "InstitutionalFlowBatch": {
      "additionalProperties": false,
      "description": "One exchange table of one trading day; the exchange's response is mandatory evidence.",
      "properties": {
        "coverage_end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage End Date"
        },
        "coverage_start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Start Date"
        },
        "data_date": {
          "format": "date",
          "title": "Data Date",
          "type": "string"
        },
        "declared_record_count": {
          "const": 1,
          "title": "Declared Record Count",
          "type": "integer"
        },
        "delivery_mode": {
          "enum": [
            "incremental",
            "backfill"
          ],
          "title": "Delivery Mode",
          "type": "string"
        },
        "sequence": {
          "default": null,
          "title": "Sequence",
          "type": "null"
        },
        "sequence_count": {
          "default": null,
          "title": "Sequence Count",
          "type": "null"
        },
        "source_raw_ref": {
          "maxLength": 2048,
          "pattern": "^r2://[0-9a-f]{32}/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9_=-][A-Za-z0-9._=-]*)+$",
          "title": "Source Raw Ref",
          "type": "string"
        },
        "source_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Raw Sha256",
          "type": "string"
        }
      },
      "required": [
        "data_date",
        "delivery_mode",
        "declared_record_count",
        "source_raw_ref",
        "source_raw_sha256"
      ],
      "title": "InstitutionalFlowBatch",
      "type": "object"
    },
    "InstitutionalFlowSummaryPayload": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "$ref": "#/$defs/InstitutionalFlowBatch"
        },
        "data": {
          "items": {
            "$ref": "#/$defs/InstitutionalFlowSummaryRow"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Data",
          "type": "array"
        }
      },
      "required": [
        "batch",
        "data"
      ],
      "title": "InstitutionalFlowSummaryPayload",
      "type": "object"
    },
    "InstitutionalFlowSummaryRow": {
      "additionalProperties": false,
      "description": "A board's market totals of one day: every leaf category and the total.",
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/InstitutionalFlowAmount"
          },
          "maxItems": 8,
          "minItems": 6,
          "title": "Categories",
          "type": "array"
        },
        "currency": {
          "const": "TWD",
          "title": "Currency",
          "type": "string"
        },
        "source_symbol": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Symbol"
        },
        "symbol": {
          "enum": [
            "TWSE",
            "TPEX"
          ],
          "title": "Symbol",
          "type": "string"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "trade_date",
        "currency",
        "categories"
      ],
      "title": "InstitutionalFlowSummaryRow",
      "type": "object"
    }
  },
