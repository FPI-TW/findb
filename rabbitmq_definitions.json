{
  "users": [
    {
      "name": "guest",
      "password": "guest",
      "tags": "administrator",
      "limits": {}
    }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "raw-data-ingest-limit",
      "pattern": "^raw_data_ingest$",
      "apply-to": "queues",
      "definition": {
        "max-length": 10000,
        "overflow": "reject-publish"
      },
      "priority": 0
    }
  ]
}
